# Server
APP_SERVER=http://localhost
APP_PORT=3000
NODE_ENV=development

# Replicate (image generation)
REPLICATE_API_TOKEN=

# MongoDB
MONGO_URI=
MONGO_DB_USER=
MONGO_DB_PASSWORD=

# Redis (generation progress cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Max concurrent generation jobs
GENERATION_CONCURRENCY=10

# Clerk auth
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Clerk webhook signing secret (svix)
WEBHOOK_SECRET=

# Cloudinary (image storage/CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_PATH=private/development/uploads

# Dodo Payments (test mode)
PAYMENT_PROVIDER=dodo
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID_PACK_200=
DODO_PRODUCT_ID_PACK_450=
DODO_PRODUCT_ID_PACK_960=
DODO_PRODUCT_ID_PACK_2000=
PAYMENT_RETURN_URL=

# Contact-form email (nodemailer)
EMAIL_USER=
EMAIL_PASSWORD=

# DeepSeek (prompt enhancement)
DEEPSEEK_API_KEY=
ENHANCE_MODEL=deepseek-chat

# Anthropic (image describe)
ANTHROPIC_API_KEY=
DESCRIBE_MODEL=claude-sonnet-4-5
