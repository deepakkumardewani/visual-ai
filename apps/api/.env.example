# Server (public URLs when using portless — see README)
APP_SERVER=https://api.visual-ai.localhost
APP_PORT=3006
NODE_ENV=development

# Browser origins for CORS (comma-separated). Include the web app URL.
ALLOWED_ORIGINS=https://visual-ai.localhost

# Replicate (image generation)
REPLICATE_API_TOKEN=

# MongoDB — local default; start Mongo first (see README / docker-compose.yml)
# ECONNREFUSED on :27017 means nothing is listening; use Atlas or `docker compose up -d mongo`.
MONGO_URI=mongodb://127.0.0.1:27017/visual-ai?directConnection=true
MONGO_DB_USER=
MONGO_DB_PASSWORD=

# Redis (generation progress cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Max concurrent generation jobs
GENERATION_CONCURRENCY=10

# Clerk auth
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Clerk webhook signing secret (svix)
WEBHOOK_SECRET=

# Cloudinary (image storage/CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_PATH=private/development/uploads

# Dodo Payments (test mode)
PAYMENT_PROVIDER=dodo
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID_PACK_200=
DODO_PRODUCT_ID_PACK_450=
DODO_PRODUCT_ID_PACK_960=
DODO_PRODUCT_ID_PACK_2000=
PAYMENT_RETURN_URL=

# Contact-form email (nodemailer)
EMAIL_USER=
EMAIL_PASSWORD=

# DeepSeek (prompt enhancement)
DEEPSEEK_API_KEY=
ENHANCE_MODEL=deepseek-chat

# Anthropic (image describe)
ANTHROPIC_API_KEY=
DESCRIBE_MODEL=claude-sonnet-4-5

# xAI Grok speech-to-text (optional — /stt returns 503 when unset)
XAI_API_KEY=

# V2 announcement email + one-click unsubscribe (all optional; the API boots without them)
# HMAC secret for unsubscribe links; unset makes /email/unsubscribe answer 400
UNSUBSCRIBE_SECRET=
# Public web origin and API origin (unsubscribe links point at the API origin)
APP_PUBLIC_URL=https://visual-ai.localhost
API_PUBLIC_URL=https://api.visual-ai.localhost
# Resend (send script only)
RESEND_API_KEY=
MAIL_FROM=
EMAIL_REPLY_TO=
# Physical postal address shown in the email footer (required for a real send)
MAIL_POSTAL_ADDRESS=
