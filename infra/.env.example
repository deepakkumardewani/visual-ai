# ============================================================================
# Visual AI - Environment Template
# ============================================================================
# Copy this file to .env.prod and .env.staging, then fill in the values
# Production: .env.prod (ENABLE_CRON=true, QUEUE_PREFIX=prod)
# Staging: .env.staging (ENABLE_CRON=false, QUEUE_PREFIX=staging)
# ============================================================================

# ============================================================================
# CORE INFRASTRUCTURE
# ============================================================================

# Docker Compose and deployment
# GHCR_IMAGE should reference your GitHub Container Registry image
# Example: ghcr.io/yourusername/visual-ai-api
GHCR_IMAGE=ghcr.io/yourusername/visual-ai-api
GHCR_TAG=latest

# Redis password - shared between all API instances
# Must match the password configured in docker-compose.yml
REDIS_PASSWORD=your-secure-redis-password-here

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================

# Node environment: production or staging
# Production: NODE_ENV=production
# Staging: NODE_ENV=staging
NODE_ENV=production

# Application server URL (used in API responses)
# Production: https://visual-ai.app
# Staging: https://staging.visual-ai.app
APP_SERVER=https://visual-ai.app

# Application port (should match the port in docker-compose.yml)
# Production: 3001 (internal port in container)
# Staging: 3001 (internal port in container, mapped to 3002 externally)
APP_PORT=3001

# Logging level (development|info|warn|error)
LOG_LEVEL=info

# ============================================================================
# ENVIRONMENT ISOLATION - Set by docker-compose.yml
# ============================================================================

# Enable cron jobs (should only be true in production)
# Production: true
# Staging: false
ENABLE_CRON=true

# Queue prefix for job isolation (prevents staging jobs from interfering with prod)
# Production: prod
# Staging: staging
QUEUE_PREFIX=prod

# Browser origins allowed to call this API (comma-separated, no trailing slash).
# Prod:    https://visual-ai.app,https://www.visual-ai.app
# Staging: https://staging.visual-ai.app
ALLOWED_ORIGINS=https://visual-ai.app,https://www.visual-ai.app

# ============================================================================
# DATABASE
# ============================================================================

# MongoDB connection URI
# Must include authentication and database name
# Example: mongodb+srv://user:password@cluster.mongodb.net/?appName=VisualAI
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=VisualAI

# Optional: MongoDB user and password (if not in URI)
MONGO_DB_USER=your-mongo-username
MONGO_DB_PASSWORD=your-mongo-password

# ============================================================================
# CACHE & QUEUE
# ============================================================================

# Redis connection (container name or hostname)
# In docker-compose: redis (internal network)
# On droplet with external Redis: your-redis-host
REDIS_HOST=redis
REDIS_PORT=6379

# Maximum concurrent image generation jobs
# Recommended: 5-15 depending on server capacity
GENERATION_CONCURRENCY=10

# ============================================================================
# EXTERNAL APIS & SERVICES
# ============================================================================

# Replicate.com - Image generation backend
REPLICATE_API_TOKEN=your-replicate-api-token

# Cloudinary - Image storage and CDN
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# CDN base path (private/production/uploads or private/staging/uploads)
CLOUDINARY_BASE_PATH=private/production/uploads

# Clerk - Authentication and user management
CLERK_PUBLISHABLE_KEY=pk_live_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_live_your-clerk-secret-key
CLERK_JWT_KEY=your-clerk-jwt-public-key

# Razorpay - Payment processing
# Note: Must use production API keys even for staging to test real payments
RAZORPAY_KEY_ID=rzp_live_your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ============================================================================
# NOTIFICATIONS & WEBHOOKS
# ============================================================================

# Email notifications (nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-app-password

# Clerk webhook signing secret (from Clerk dashboard)
WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================================================
# AI INTEGRATIONS
# ============================================================================

# DeepSeek - Prompt enhancement
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
ENHANCE_MODEL=deepseek-chat

# Anthropic/Claude - Image description
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
DESCRIBE_MODEL=claude-sonnet-4-5

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# Production (.env.prod):
#  - ENABLE_CRON=true (cron jobs run only in production)
#  - QUEUE_PREFIX=prod (production job queue namespace)
#  - APP_SERVER=https://visual-ai.app
#  - Separate MongoDB database for production data
#
# Staging (.env.staging):
#  - ENABLE_CRON=false (prevent duplicate jobs)
#  - QUEUE_PREFIX=staging (isolated staging queue)
#  - APP_SERVER=https://staging.visual-ai.app
#  - Separate MongoDB database for staging data
#  - Can use same Razorpay/Clerk/Cloudinary keys for testing
#
# Security:
#  - NEVER commit .env.prod or .env.staging
#  - Rotate sensitive keys (API tokens, secrets) regularly
#  - Use strong REDIS_PASSWORD (32+ characters recommended)
#  - Keep WEBHOOK_SECRET and API keys confidential
#
# Redis Password:
#  - Must be set in both docker-compose.yml and .env files
#  - Change for production deployments
#  - Use a secure password generator
#
