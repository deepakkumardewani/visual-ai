{
  "name": "visual-ai",
  "version": "2.0.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "portless",
    "dev:web": "cd apps/web && portless",
    "dev:api": "cd apps/api && portless",
    "dev:direct:web": "PORTLESS=0 vp dev apps/web",
    "dev:direct:api": "PORTLESS=0 bun --cwd apps/api dev",
    "build:web": "vp build apps/web",
    "build:api": "cd apps/api && bun build",
    "lint": "vp lint --fix",
    "check": "vp check",
    "verify": "vp lint --fix && vp check --fix",
    "test": "vp test run",
    "check:model-docs": "bun scripts/check-model-docs.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8"
  },
  "devDependencies": {
    "portless": "^0.15.11",
    "vite-plus": "0.1.18"
  },
  "overrides": {
    "@vitest/coverage-v8": "4.1.9"
  },
  "packageManager": "bun@1.3.6"
}
